tatus, SortByField } from '../types/task';\r\nimport { Search, X, ArrowUpDown, Filter } from 'lucide-react';\r\n\r\nexport const FilterBar: React.FC = () => {\r\n  const { filters, setFilters, resetFilters, categories, filteredTasks, tasks } = useTaskContext();\r\n\r\n  const isFiltered =\r\n    filters.searchQuery.trim() !== '' ||\r\n    filters.status !== 'all' ||\r\n    filters.priority !== 'all' ||\r\n    filters.category !== 'all';\r\n\r\n  return (\r\n    <div className=\"filter-bar\">\r\n      {/* Top row: Search and Sorting */}\r\n      <div className=\"filter-top-row\">\r\n        {/* Search Input */}\r\n        <div className=\"search-field-wrapper\">\r\n          <Search size={16} className=\"search-field-icon\" />\r\n          <input\r\n            type=\"text\"\r\n            value={filters.searchQuery}\r\n            onChange={(e) => setFilters({ searchQuery: e.target.value })}\r\n            placeholder=\"Search by title, description, or category...\"\r\n            className=\"search-input\"\r\n          />\r\n          {filters.searchQuery && (\r\n            <button\r\n              type=\"button\"\r\n              onClick={() => setFilters({ searchQuery: '' })}\r\n              className=\"search-clear-btn\"\r\n            >\r\n              <X size={14} />\r\n            </button>\r\n          )}\r\n        </div>\r\n\r\n        {/* Sort Controls */}\r\n        <div className=\"sort-group\">\r\n          <div className=\"control-label\">\r\n            <ArrowUpDown size={14} />\r\n            <span>Sort by:</span>\r\n          </div>\r\n          <select\r\n            value={filters.sortBy}\r\n            onChange={(e) => setFilters({ sortBy: e.target.value as SortByField })}\r\n            className=\"select-control\"\r\n          >\r\n            <option value=\"createdAt\">Date Created</option>\r\n            <option value=\"dueDate\">Due Date</option>\r\n            <option value=\"priority\">Priority</option>\r\n            <option value=\"title\">Alphabetical</option>\r\n          </select>\r\n          <button\r\n            type=\"button\"\r\n            onClick={() =>\r\n              setFilters({\r\n                sortOrder: filters.sortOrder === 'asc' ? 'desc' : 'asc',\r\n              })\r\n            }\r\n            className=\"btn-secondary\"\r\n          >\r\n            {filters.sortOrder === 'asc' ? 'Asc ↑' : 'Desc ↓'}\r\n          </button>\r\n        </div>\r\n      </div>\r\n\r\n      {/* Bottom row: Filters & Results count */}\r\n      <div className=\"filter-bottom-row\">\r\n        <div className=\"filters-list\">\r\n          <div className=\"control-label\">\r\n            <Filter size={14} />\r\n            <span>Filters:</span>\r\n          </div>\r\n\r\n          {/* Status Filter */}\r\n          <select\r\n            value={filters.status}\r\n            onChange={(e) => setFilters({ status: e.target.value as 'all' | TaskStatus })}\r\n            className=\"select-control\"\r\n          >\r\n            <option value=\"all\">All Statuses</option>\r\n            <option value=\"todo\">To Do</option>\r\n            <option value=\"in_progress\">In Progress</option>\r\n            <option value=\"completed\">Completed</option>\r\n          </select>\r\n\r\n          {/* Priority Filter */}\r\n          <select\r\n            value={filters.priority}\r\n            onChange={(e) => setFilters({ priority: e.target.value as 'all' | TaskPriority })}\r\n            className=\"select-control\"\r\n          >\r\n            <option value=\"all\">All Priorities</option>\r\n            <option value=\"urgent\">Urgent</option>\r\n            <option value=\"high\">High</option>\r\n            <option value=\"medium\">Medium</option>\r\n            <option value=\"low\">Low</option>\r\n          </select>\r\n\r\n          {/* Category Filter */}\r\n          <select\r\n            value={filters.category}\r\n            onChange={(e) => setFilters({ category: e.target.value })}\r\n            className=\"select-control\"\r\n          >\r\n            <option value=\"all\">All Categories</option>\r\n            {categories.map((c) => (\r\n              <option key={c} value={c}>\r\n                {c}\r\n              </option>\r\n            ))}\r\n          </select>\r\n\r\n          {isFiltered && (\r\n            <button\r\n              type=\"button\"\r\n              onClick={resetFilters}\r\n              className=\"btn-reset-filters\"\r\n            >\r\n              Reset filters\r\n            </button>\r\n          )}\r\n        </div>\r\n\r\n        {/* Counter */}\r\n        <div className=\"results-counter\">\r\n          Showing <strong>{filteredTasks.length}</strong> of {tasks.length} tasks\r\n        </div>\r\n      </div>\r\n    </div>\r\n  );\r\n};\r\n"],"file":"/src/components/FilterBar.tsx"}