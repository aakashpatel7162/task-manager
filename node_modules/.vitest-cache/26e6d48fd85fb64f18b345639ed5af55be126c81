,oDAAC,mCAAS,MAAM,MAAhB;AAAA;AAAA;AAAA;AAAA,mBAAoB;AAAA,YAC7D,iDAAC,UACE,sBAAY,YAAY,KAAK,OAAO,MAAM,aAAa,cAAc,KAAK,WAD7E;AAAA;AAAA;AAAA;AAAA,mBAEA;AAAA;AAAA;AAAA,QARF;AAAA;AAAA;AAAA;AAAA;AAAA;AAAA;AAAA;AAAA,MASA,IAEA,iDAAC,UAAK,OAAO,EAAE,UAAU,WAAW,OAAO,wBAAwB,WAAW,SAAS,GAAG,2BAA1F;AAAA;AAAA;AAAA;AAAA,aAEA;AAAA,MAGF;AAAA,QAAC;AAAA;AAAA,UACC,OAAO,KAAK;AAAA,UACZ,UAAU,CAAC,MAAM,iBAAiB,KAAK,IAAI,EAAE,OAAO,KAAmB;AAAA,UACvE,WAAU;AAAA,UACV,OAAO,EAAE,SAAS,kBAAkB,UAAU,UAAU;AAAA,UAExD;AAAA,6DAAC,YAAO,OAAM,QAAO,qBAArB;AAAA;AAAA;AAAA;AAAA,mBAA0B;AAAA,YAC1B,iDAAC,YAAO,OAAM,eAAc,2BAA5B;AAAA;AAAA;AAAA;AAAA,mBAAuC;AAAA,YACvC,iDAAC,YAAO,OAAM,aAAY,oBAA1B;AAAA;AAAA;AAAA;AAAA,mBAA8B;AAAA;AAAA;AAAA,QARhC;AAAA;AAAA;AAAA;AAAA;AAAA;AAAA;AAAA;AAAA,MASA;AAAA,SA3BF;AAAA;AAAA;AAAA;AAAA,WA4BA;AAAA,OAtJF;AAAA;AAAA;AAAA;AAAA,SAuJA;AAEJ","names":[],"ignoreList":[],"sources":["TaskCard.tsx"],"sourcesContent":["import React, { useState } from 'react';\r\nimport { Task, TaskPriority, TaskStatus } from './types';\r\nimport { useTaskContext } from './TaskContext';\r\nimport {\r\n  Calendar,\r\n  CheckCircle2,\r\n  Circle,\r\n  MoreVertical,\r\n  Pencil,\r\n  Trash2,\r\n  ChevronDown,\r\n  ChevronUp,\r\n  AlertCircle,\r\n} from 'lucide-react';\r\n\r\ninterface TaskCardProps {\r\n  task: Task;\r\n}\r\n\r\nexport const TaskCard: React.FC<TaskCardProps> = ({ task }) => {\r\n  const { openEditModal, deleteTask, changeTaskStatus, toggleSubtask } = useTaskContext();\r\n  const [showSubtasks, setShowSubtasks] = useState(false);\r\n  const [showMenu, setShowMenu] = useState(false);\r\n\r\n  const todayStr = new Date().toISOString().split('T')[0];\r\n  const isOverdue = task.dueDate && task.dueDate < todayStr && task.status !== 'completed';\r\n  const isDueToday = task.dueDate === todayStr;\r\n\r\n  const priorityClasses: Record<TaskPriority, string> = {\r\n    urgent: 'priority-urgent',\r\n    high: 'priority-high',\r\n    medium: 'priority-medium',\r\n    low: 'priority-low',\r\n  };\r\n\r\n  const statusProgress: Record<TaskStatus, TaskStatus> = {\r\n    todo: 'in_progress',\r\n    in_progress: 'completed',\r\n    completed: 'todo',\r\n  };\r\n\r\n  const completedSubtasksCount = task.subtasks.filter((s) => s.completed).length;\r\n\r\n  return (\r\n    <div className={`task-card ${task.status === 'completed' ? 'is-completed' : ''}`}>\r\n      <div className=\"task-card-header\">\r\n        <div className=\"badge-group\">\r\n          <span className={`priority-pill ${priorityClasses[task.priority]}`}>\r\n            {task.priority}\r\n          </span>\r\n          <span className=\"category-pill\">\r\n            {task.category}\r\n          </span>\r\n        </div>\r\n\r\n        <div className=\"card-options-wrapper\">\r\n          <button\r\n            type=\"button\"\r\n            onClick={() => setShowMenu((prev) => !prev)}\r\n            className=\"icon-btn\"\r\n            style={{ width: '1.8rem', height: '1.8rem' }}\r\n          >\r\n            <MoreVertical size={16} />\r\n          </button>\r\n\r\n          {showMenu && (\r\n            <div\r\n              className=\"dropdown-popup\"\r\n              onMouseLeave={() => setShowMenu(false)}\r\n            >\r\n              <button\r\n                type=\"button\"\r\n                onClick={() => {\r\n                  setShowMenu(false);\r\n                  openEditModal(task);\r\n                }}\r\n                className=\"dropdown-item\"\r\n              >\r\n                <Pencil size={14} />\r\n                Edit Task\r\n              </button>\r\n              <button\r\n                type=\"button\"\r\n                onClick={() => {\r\n                  setShowMenu(false);\r\n                  changeTaskStatus(task.id, statusProgress[task.status]);\r\n                }}\r\n                className=\"dropdown-item\"\r\n              >\r\n                <CheckCircle2 size={14} />\r\n                {task.status === 'completed' ? 'Reopen' : 'Advance'}\r\n              </button>\r\n              <button\r\n                type=\"button\"\r\n                onClick={() => {\r\n                  setShowMenu(false);\r\n                  if (window.confirm(`Delete task \"${task.title}\"?`)) {\r\n                    deleteTask(task.id);\r\n                  }\r\n                }}\r\n                className=\"dropdown-item danger\"\r\n              >\r\n                <Trash2 size={14} />\r\n                Delete\r\n              </button>\r\n            </div>\r\n          )}\r\n        </div>\r\n      </div>\r\n\r\n      <h3\r\n        className={`task-title ${task.status === 'completed' ? 'strikethrough' : ''}`}\r\n        onClick={() => openEditModal(task)}\r\n      >\r\n        {task.title}\r\n      </h3>\r\n\r\n      {task.description && (\r\n        <p className=\"task-description\">\r\n          {task.description}\r\n        </p>\r\n      )}\r\n\r\n      {task.subtasks.length > 0 && (\r\n        <div className=\"subtasks-container\">\r\n          <button\r\n            type=\"button\"\r\n            onClick={() => setShowSubtasks((prev) => !prev)}\r\n            className=\"subtasks-header-toggle\"\r\n          >\r\n            <span>\r\n              Subtasks ({completedSubtasksCount}/{task.subtasks.length})\r\n            </span>\r\n            {showSubtasks ? <ChevronUp size={14} /> : <ChevronDown size={14} />}\r\n          </button>\r\n\r\n          <div className=\"progress-track\">\r\n            <div\r\n              className=\"progress-fill\"\r\n              style={{\r\n                width: `${(completedSubtasksCount / task.subtasks.length) * 100}%`,\r\n              }}\r\n            />\r\n          </div>\r\n\r\n          {showSubtasks && (\r\n            <div className=\"subtasks-items-list\">\r\n              {task.subtasks.map((sub) => (\r\n                <div\r\n                  key={sub.id}\r\n                  onClick={() => toggleSubtask(task.id, sub.id)}\r\n                  className={`subtask-row ${sub.completed ? 'is-done' : ''}`}\r\n                >\r\n                  {sub.completed ? (\r\n                    <CheckCircle2 size={14} color=\"#10b981\" />\r\n                  ) : (\r\n                    <Circle size={14} color=\"#94a3b8\" />\r\n                  )}\r\n                  <span>{sub.title}</span>\r\n                </div>\r\n              ))}\r\n            </div>\r\n          )}\r\n        </div>\r\n      )}\r\n\r\n      <div className=\"task-card-footer\">\r\n        {task.dueDate ? (\r\n          <div\r\n            className={`date-indicator ${\r\n              isOverdue ? 'is-overdue' : isDueToday ? 'is-due-today' : ''\r\n            }`}\r\n          >\r\n            {isOverdue ? <AlertCircle size={14} /> : <Calendar size={14} />}\r\n            <span>\r\n              {isOverdue ? `Overdue (${task.dueDate})` : isDueToday ? 'Due Today' : task.dueDate}\r\n            </span>\r\n          </div>\r\n        ) : (\r\n          <span style={{ fontSize: '0.72rem', color: 'var(--text-disabled)', fontStyle: 'italic' }}>\r\n            No due date\r\n          </span>\r\n        )}\r\n\r\n        <select\r\n          value={task.status}\r\n          onChange={(e) => changeTaskStatus(task.id, e.target.value as TaskStatus)}\r\n          className=\"select-control\"\r\n          style={{ padding: '0.25rem 0.5rem', fontSize: '0.75rem' }}\r\n        >\r\n          <option value=\"todo\">To Do</option>\r\n          <option value=\"in_progress\">In Progress</option>\r\n          <option value=\"completed\">Done</option>\r\n        </select>\r\n      </div>\r\n    </div>\r\n  );\r\n};\r\n"],"file":"/src/TaskCard.tsx"}