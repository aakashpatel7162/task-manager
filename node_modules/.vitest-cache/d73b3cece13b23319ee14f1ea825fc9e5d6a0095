'./TaskContext';\r\nimport { TaskPriority, TaskStatus } from './types';\r\nimport { X, Plus, Trash2, Calendar, Tag, AlertCircle } from 'lucide-react';\r\n\r\nexport const TaskModal: React.FC = () => {\r\n  const { isModalOpen, closeModal, editingTask, addTask, updateTask, categories } = useTaskContext();\r\n\r\n  const [title, setTitle] = useState('');\r\n  const [description, setDescription] = useState('');\r\n  const [status, setStatus] = useState<TaskStatus>('todo');\r\n  const [priority, setPriority] = useState<TaskPriority>('medium');\r\n  const [category, setCategory] = useState('General');\r\n  const [customCategory, setCustomCategory] = useState('');\r\n  const [dueDate, setDueDate] = useState('');\r\n  const [subtasks, setSubtasks] = useState<{ title: string; completed: boolean }[]>([]);\r\n  const [newSubtaskTitle, setNewSubtaskTitle] = useState('');\r\n  const [error, setError] = useState('');\r\n\r\n  useEffect(() => {\r\n    if (editingTask) {\r\n      setTitle(editingTask.title);\r\n      setDescription(editingTask.description || '');\r\n      setStatus(editingTask.status);\r\n      setPriority(editingTask.priority);\r\n      setCategory(editingTask.category);\r\n      setDueDate(editingTask.dueDate || '');\r\n      setSubtasks(editingTask.subtasks.map((s) => ({ title: s.title, completed: s.completed })));\r\n      setCustomCategory('');\r\n    } else {\r\n      setTitle('');\r\n      setDescription('');\r\n      setStatus('todo');\r\n      setPriority('medium');\r\n      setCategory('Engineering');\r\n      setDueDate('');\r\n      setSubtasks([]);\r\n      setCustomCategory('');\r\n    }\r\n    setError('');\r\n  }, [editingTask, isModalOpen]);\r\n\r\n  if (!isModalOpen) return null;\r\n\r\n  const handleAddSubtask = () => {\r\n    if (newSubtaskTitle.trim()) {\r\n      setSubtasks((prev) => [...prev, { title: newSubtaskTitle.trim(), completed: false }]);\r\n      setNewSubtaskTitle('');\r\n    }\r\n  };\r\n\r\n  const handleRemoveSubtask = (index: number) => {\r\n    setSubtasks((prev) => prev.filter((_, i) => i !== index));\r\n  };\r\n\r\n  const handleSubmit = (e: React.FormEvent) => {\r\n    e.preventDefault();\r\n    if (!title.trim()) {\r\n      setError('Task title is required');\r\n      return;\r\n    }\r\n\r\n    const finalCategory = category === '__custom__' ? customCategory.trim() || 'General' : category;\r\n\r\n    if (editingTask) {\r\n      updateTask(editingTask.id, {\r\n        title: title.trim(),\r\n        description: description.trim(),\r\n        status,\r\n        priority,\r\n        category: finalCategory,\r\n        dueDate: dueDate || undefined,\r\n        subtasks: subtasks.map((s, idx) => ({\r\n          id: editingTask.subtasks[idx]?.id || `sub-${Date.now()}-${idx}`,\r\n          title: s.title,\r\n          completed: s.completed,\r\n        })),\r\n      });\r\n    } else {\r\n      addTask({\r\n        title: title.trim(),\r\n        description: description.trim(),\r\n        status,\r\n        priority,\r\n        category: finalCategory,\r\n        dueDate: dueDate || undefined,\r\n        subtasks,\r\n      });\r\n    }\r\n\r\n    closeModal();\r\n  };\r\n\r\n  return (\r\n    <div className=\"modal-overlay\">\r\n      <div className=\"modal-dialog\">\r\n        <div className=\"modal-header\">\r\n          <h2 className=\"modal-title\">\r\n            {editingTask ? 'Edit Task' : 'Create New Task'}\r\n          </h2>\r\n          <button\r\n            type=\"button\"\r\n            onClick={closeModal}\r\n            className=\"icon-btn\"\r\n          >\r\n            <X size={18} />\r\n          </button>\r\n        </div>\r\n\r\n        <form onSubmit={handleSubmit}>\r\n          <div className=\"modal-body\">\r\n            {error && (\r\n              <div className=\"alert-message alert-error\">\r\n                <AlertCircle size={16} />\r\n                <span>{error}</span>\r\n              </div>\r\n            )}\r\n\r\n            <div className=\"form-group\">\r\n              <label className=\"form-label\">\r\n                Task Title <span className=\"required-mark\">*</span>\r\n              </label>\r\n              <input\r\n                type=\"text\"\r\n                value={title}\r\n                onChange={(e) => {\r\n                  setTitle(e.target.value);\r\n                  if (error) setError('');\r\n                }}\r\n                placeholder=\"e.g. Redesign authentication flow\"\r\n                className=\"text-input\"\r\n                autoFocus\r\n              />\r\n            </div>\r\n\r\n            <div className=\"form-group\">\r\n              <label className=\"form-label\">\r\n                Description\r\n              </label>\r\n              <textarea\r\n                value={description}\r\n                onChange={(e) => setDescription(e.target.value)}\r\n                placeholder=\"Add extra context, specifications, or links...\"\r\n                rows={3}\r\n                className=\"text-area\"\r\n              />\r\n            </div>\r\n\r\n            <div className=\"form-row\">\r\n              <div className=\"form-group\">\r\n                <label className=\"form-label\">\r\n                  Status\r\n                </label>\r\n                <select\r\n                  value={status}\r\n                  onChange={(e) => setStatus(e.target.value as TaskStatus)}\r\n                  className=\"select-control\"\r\n                >\r\n                  <option value=\"todo\">To Do</option>\r\n                  <option value=\"in_progress\">In Progress</option>\r\n                  <option value=\"completed\">Completed</option>\r\n                </select>\r\n              </div>\r\n\r\n              <div className=\"form-group\">\r\n                <label className=\"form-label\">\r\n                  Priority\r\n                </label>\r\n                <select\r\n                  value={priority}\r\n                  onChange={(e) => setPriority(e.target.value as TaskPriority)}\r\n                  className=\"select-control\"\r\n                >\r\n                  <option value=\"low\">Low</option>\r\n                  <option value=\"medium\">Medium</option>\r\n                  <option value=\"high\">High</option>\r\n                  <option value=\"urgent\">Urgent</option>\r\n                </select>\r\n              </div>\r\n            </div>\r\n\r\n            <div className=\"form-row\">\r\n              <div className=\"form-group\">\r\n                <label className=\"form-label\">\r\n                  <Tag size={13} />\r\n                  Category\r\n                </label>\r\n                <select\r\n                  value={category}\r\n                  onChange={(e) => setCategory(e.target.value)}\r\n                  className=\"select-control\"\r\n                >\r\n                  {categories.map((c) => (\r\n                    <option key={c} value={c}>\r\n                      {c}\r\n                    </option>\r\n                  ))}\r\n                  {!categories.includes('Engineering') && <option value=\"Engineering\">Engineering</option>}\r\n                  {!categories.includes('Product') && <option value=\"Product\">Product</option>}\r\n                  {!categories.includes('Personal') && <option value=\"Personal\">Personal</option>}\r\n                  <option value=\"__custom__\">+ Custom Category...</option>\r\n                </select>\r\n                {category === '__custom__' && (\r\n                  <input\r\n                    type=\"text\"\r\n                    value={customCategory}\r\n                    onChange={(e) => setCustomCategory(e.target.value)}\r\n                    placeholder=\"Enter custom category\"\r\n                    className=\"text-input\"\r\n                    style={{ marginTop: '0.4rem' }}\r\n                  />\r\n                )}\r\n              </div>\r\n\r\n              <div className=\"form-group\">\r\n                <label className=\"form-label\">\r\n                  <Calendar size={13} />\r\n                  Due Date\r\n                </label>\r\n                <input\r\n                  type=\"date\"\r\n                  value={dueDate}\r\n                  onChange={(e) => setDueDate(e.target.value)}\r\n                  className=\"text-input\"\r\n                />\r\n              </div>\r\n            </div>\r\n\r\n            <div className=\"form-group\" style={{ paddingTop: '0.5rem', borderTop: '1px solid var(--border-subtle)' }}>\r\n              <label className=\"form-label\" style={{ marginBottom: '0.5rem' }}>\r\n                Subtasks Checklist\r\n              </label>\r\n\r\n              <div className=\"subtasks-edit-list\">\r\n                {subtasks.map((sub, index) => (\r\n                  <div key={index} className=\"subtask-edit-item\">\r\n                    <span>{sub.title}</span>\r\n                    <button\r\n                      type=\"button\"\r\n                      onClick={() => handleRemoveSubtask(index)}\r\n                      className=\"icon-btn\"\r\n                      style={{ width: '1.6rem', height: '1.6rem', color: 'var(--danger-text)' }}\r\n                    >\r\n                      <Trash2 size={13} />\r\n                    </button>\r\n                  </div>\r\n                ))}\r\n              </div>\r\n\r\n              <div className=\"subtask-input-row\">\r\n                <input\r\n                  type=\"text\"\r\n                  value={newSubtaskTitle}\r\n                  onChange={(e) => setNewSubtaskTitle(e.target.value)}\r\n                  onKeyDown={(e) => {\r\n                    if (e.key === 'Enter') {\r\n                      e.preventDefault();\r\n                      handleAddSubtask();\r\n                    }\r\n                  }}\r\n                  placeholder=\"Add subtask and press enter...\"\r\n                  className=\"text-input\"\r\n                />\r\n                <button\r\n                  type=\"button\"\r\n                  onClick={handleAddSubtask}\r\n                  className=\"btn-secondary\"\r\n                  style={{ display: 'inline-flex', alignItems: 'center', gap: '0.25rem' }}\r\n                >\r\n                  <Plus size={14} />\r\n                  Add\r\n                </button>\r\n              </div>\r\n            </div>\r\n          </div>\r\n\r\n          <div className=\"modal-footer\">\r\n            <button\r\n              type=\"button\"\r\n              onClick={closeModal}\r\n              className=\"btn-secondary\"\r\n            >\r\n              Cancel\r\n            </button>\r\n            <button\r\n              type=\"submit\"\r\n              className=\"btn-primary\"\r\n            >\r\n              {editingTask ? 'Save Changes' : 'Create Task'}\r\n            </button>\r\n          </div>\r\n        </form>\r\n      </div>\r\n    </div>\r\n  );\r\n};\r\n"],"file":"/src/TaskModal.tsx"}